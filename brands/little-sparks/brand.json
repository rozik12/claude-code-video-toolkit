{
  "name": "Little Sparks",
  "description": "Bright, soft, high-contrast brand for English learning videos for kids aged 3-7",
  "version": "1.0.0",

  "colors": {
    "primary": "#ff7a3d",
    "primaryLight": "#ffb07a",
    "accent": "#3dbcff",
    "accent2": "#7ed957",
    "accent3": "#ffd23d",
    "textDark": "#2b2d42",
    "textMedium": "#4a4e69",
    "textLight": "#6c6f8a",
    "bgLight": "#fff8ec",
    "bgDark": "#2b2d42",
    "bgOverlay": "rgba(255, 248, 236, 0.95)",
    "divider": "#ffe3c2",
    "shadow": "rgba(43, 45, 66, 0.15)"
  },

  "fonts": {
    "primary": "'Baloo 2', 'Nunito', system-ui, sans-serif",
    "mono": "ui-monospace, Menlo, monospace"
  },

  "spacing": { "xs": 8, "sm": 16, "md": 24, "lg": 48, "xl": 80, "xxl": 120 },
  "borderRadius": { "sm": 16, "md": 28, "lg": 48 },

  "typography": {
    "h1": { "size": 120, "weight": 800 },
    "h2": { "size": 96, "weight": 800 },
    "h3": { "size": 64, "weight": 700 },
    "body": { "size": 56, "weight": 600 },
    "label": { "size": 40, "weight": 700, "letterSpacing": 1 }
  }
}
